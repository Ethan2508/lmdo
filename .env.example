# Variables d'environnement (à configurer dans Vercel → Settings → Environment Variables)

# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# Expéditeur — DOIT utiliser un domaine vérifié dans Resend.
# Tant que laimaisondelor.shop n'est pas vérifié, laisser sur onboarding@resend.dev
# pour les tests, mais ça ne pourra envoyer qu'à l'adresse propriétaire du compte Resend.
MAIL_FROM="La Maison de l'Or <contact@laimaisondelor.shop>"

# Destinataire (boîte Gmail du client)
MAIL_TO=contactreservations.lmdo@gmail.com

# Clé Google Maps (déjà existante pour /api/reviews)
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
